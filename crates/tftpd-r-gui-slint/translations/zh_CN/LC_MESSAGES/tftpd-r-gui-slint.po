msgstr "客户端"

msgid "Close"
msgstr "关闭"

msgid "Component-wise path sandbox that rejects traversal, symlinks and device names"
msgstr "组件级路径沙箱，拒绝越权、符号链接与设备名"

msgid "Current"
msgstr "当前"

