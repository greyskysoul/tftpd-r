msgstr "文件"

msgid "Follow system"
msgstr "跟随系统"

msgid "Icons: Google Material Design Icons (Apache License 2.0)"
msgstr "图标：Google Material Design Icons（Apache License 2.0）"

msgid "INFO only"
msgstr "仅 INFO"

msgid "Language: {}"
msgstr "语言：{}"

msgid "License: MIT OR Apache-2.0 · uploads are not implemented, the server is read-only"
msgstr "许可证：MIT OR Apache-2.0 · 上传功能未实现，服务端默认只读"

msgid "Light"
msgstr "浅色"

msgid "Max block size"
msgstr "最大块大小"

