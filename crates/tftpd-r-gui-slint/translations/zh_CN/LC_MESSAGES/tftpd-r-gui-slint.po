# Simplified Chinese translation for the TftpdR panel.
#
# The English strings in the .slint files are the source language, so this
# catalogue only has to provide the translations. The compiler bundles it into
# the executable (see build.rs) and the panel selects it at startup when the
# system locale is Simplified Chinese; every other locale keeps the source
# strings.
#
# The content has no message context: build.rs compiles with
# `DefaultTranslationContext::None`, so msgids are the plain source strings.
# `cargo test -p tftpd-r-gui-slint` checks that every @tr() string in the .slint
# files has an entry here and that unused entries are removed.
msgid ""
msgstr ""
"Project-Id-Version: TftpdR\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "About"
msgstr "关于"

msgid "Activity log"
msgstr "运行日志"

msgid "All levels"
msgstr "全部级别"

msgid "Allow uploads (WRQ) — not implemented in this release"
msgstr "允许上传（WRQ）— 本版本尚未实现"

msgid "Appearance"
msgstr "外观"

msgid "Applies immediately and is remembered."
msgstr "立即生效并记住选择。"

msgid "Bind addresses"
msgstr "绑定地址"

msgid "blksize / timeout / tsize option negotiation and retransmission"
msgstr "blksize / timeout / tsize 选项协商与重传"

msgid "Browse…"
msgstr "浏览…"

msgid "Cancel"
msgstr "取消"

msgid "Clear"
msgstr "清空"

