msgstr "最大并发会话"

msgid "Multi-select. Choosing a specific address clears “All networks”; choosing “All networks” clears the other addresses. The port applies to every address."
msgstr "可多选。选中具体地址会自动取消「全部网络」；选中「全部网络」会清空其他地址。端口对所有地址生效。"

msgid "Newest first"
msgstr "最新在上"

msgid "No entries at the selected level."
msgstr "当前筛选级别下没有日志。"

msgid "No log entries yet. Connection and transfer events appear here once the server starts."
msgstr "尚无日志。启动服务后，连接与传输事件会显示在这里。"

msgid "No recent directories. Click “Select…” to choose and apply a root directory directly."
msgstr "暂无最近使用的目录。点击“选择…”可直接选择一个根目录并应用。"

msgid "No transfers. Client downloads appear here once the server starts."
msgstr "暂无传输。服务启动后，客户端下载文件会显示在这里。"

msgid "Port"
msgstr "端口"

msgid "Progress"
msgstr "进度"

msgid "Read-only: uploads are disabled in the protocol layer."
msgstr "只读模式：上传已在协议层禁用。"

msgid "Recent root directories"
msgstr "最近使用的根目录"

msgid "Restart"
msgstr "重启"

msgid "RFC 1350 · read-only RRQ · uploads disabled"
msgstr "RFC 1350 · 只读 RRQ · 上传已禁用"

msgid "RFC 1350 RRQ downloads, WRQ explicitly refused (read-only)"
msgstr "RFC 1350 RRQ 下载，WRQ 显式拒绝（只读）"

msgid "Root directory"
msgstr "根目录"

msgid "Rust TFTP server"
msgstr "Rust TFTP 服务端"

