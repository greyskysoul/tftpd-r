// Row models shared between the Slint UI and the Rust glue in `src/main.rs`.

export struct TransferRow {
    id: int,
    file: string,
    peer: string,
    bytes: string,
    percent: string,
    progress: float,
    status: string,
}

export struct LogRow {
    time: string,
    level: string,
    message: string,
}

// One entry of the "recent root directories" drop-down.
export struct RecentDir {
    path: string,
    name: string,
    active: bool,
}

// One selectable bind address in the settings dialog. `address` is the
// canonical IP literal the Rust side parses back into `ServerConfig`.
export struct AddressOption {
    label: string,
    address: string,
    selected: bool,
}
