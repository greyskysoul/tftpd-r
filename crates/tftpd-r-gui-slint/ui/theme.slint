// Shared palette for the TftpdR panel. Kept in one place so the toolbar, the
// content panels and the status bar stay visually consistent.
export global Theme {
    in-out property <color> app-bg: #eef2f6;
    in-out property <color> panel-bg: #ffffff;
    in-out property <color> panel-border: #e2e8f0;
    in-out property <color> panel-border-strong: #cbd5e1;
    in-out property <color> header-bg: #f8fafc;

    in-out property <color> toolbar-bg: #0f172a;
    in-out property <color> titlebar-bg: #0b1220;
    in-out property <color> window-border: #334155;
    in-out property <color> toolbar-hover: #1e293b;
    in-out property <color> toolbar-divider: #243041;
    in-out property <color> toolbar-icon: #cbd5e1;
    in-out property <color> toolbar-icon-disabled: #475569;
    in-out property <color> toolbar-label: #e2e8f0;
    in-out property <color> toolbar-brand: #2563eb;

    in-out property <color> text-strong: #0f172a;
    in-out property <color> text: #334155;
    in-out property <color> text-muted: #64748b;
    in-out property <color> text-faint: #94a3b8;

    in-out property <color> accent: #2563eb;
    in-out property <color> accent-strong: #1d4ed8;
    in-out property <color> success: #16a34a;
    in-out property <color> warning: #d97706;
    in-out property <color> danger: #dc2626;

    in-out property <color> track: #e2e8f0;
    in-out property <color> row-hover: #f8fafc;
    in-out property <color> row-alt: #fbfdff;
    in-out property <color> scrim: #66111827;
}
