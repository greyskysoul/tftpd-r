// Shared palette for the TftpdR panel. Kept in one place so the toolbar, the
// content panels and the status bar stay visually consistent.
export global Theme {
    in-out property <color> app-bg: #eef2f6;
    in-out property <color> panel-bg: #ffffff;
    in-out property <color> panel-border: #e2e8f0;
    in-out property <color> panel-border-strong: #cbd5e1;
    in-out property <color> header-bg: #f8fafc;

    // The title bar and the toolbar form one flat dark-blue-grey header block.
    // #37474f (Material Blue Grey 800) is deliberately one step lighter than the
    // #263238 brand tile, so the product mark keeps its rounded-square shape on
    // the header. The panel itself uses no gradients.
    in-out property <color> toolbar-bg: #37474f;
    in-out property <color> titlebar-bg: #37474f;
    in-out property <color> window-border: #455a64;
    in-out property <color> toolbar-hover: rgba(255, 255, 255, 0.08);
    in-out property <color> toolbar-pressed: rgba(255, 255, 255, 0.14);
    in-out property <color> toolbar-divider: #2b3a41;
    in-out property <color> toolbar-icon: #cfd8dc;
    in-out property <color> toolbar-icon-disabled: #607d8b;
    in-out property <color> toolbar-label: #eceff1;
    // Product mark (see ui/icons/app-icon.svg): #263238 tile, #fafafa glyph.
    in-out property <color> brand-bg: #263238;
    in-out property <color> brand-glyph: #fafafa;

    in-out property <color> text-strong: #0f172a;
    in-out property <color> text: #334155;
    in-out property <color> text-muted: #64748b;
    in-out property <color> text-faint: #94a3b8;

    in-out property <color> accent: #2563eb;
    in-out property <color> accent-strong: #1d4ed8;
    in-out property <color> success: #16a34a;
    in-out property <color> warning: #d97706;
    in-out property <color> danger: #dc2626;

    in-out property <color> track: #e2e8f0;
    in-out property <color> row-hover: #f8fafc;
    in-out property <color> row-alt: #fbfdff;
    in-out property <color> scrim: #66111827;
}
