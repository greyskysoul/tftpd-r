// Shared palette for the TftpdR panel.
//
// Every colour the panel draws comes from a token here, so the light and the
// dark palette stay in one place instead of being scattered over the
// components. `dark` is set from Rust (`theme.rs`): it is the resolved choice
// of "follow the system / light / dark". `mode` mirrors the settings selection
// so the dialog can highlight it.
//
// The header block (title bar + toolbar) is dark in both modes; only its exact
// shade changes so it still separates from the content background.
//
// The window binds `Palette.color-scheme` to `dark` (see app.slint) so the
// standard widgets (ScrollView scrollbars) match the custom palette.
export global Theme {
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> mode: 0;
    // Resolved colour scheme of the panel, computed by Rust.
    in-out property <bool> dark: false;

    // --- Surfaces ---------------------------------------------------------
    out property <color> app-bg: dark ? #12161a : #eef2f6;
    out property <color> panel-bg: dark ? #1b2128 : #ffffff;
    out property <color> panel-border: dark ? #2a333d : #e2e8f0;
    out property <color> panel-border-strong: dark ? #3a4652 : #cbd5e1;
    out property <color> header-bg: dark ? #222a33 : #f8fafc;

    // Title bar and toolbar form one flat header block. In the light palette
    // #37474f (Material Blue Grey 800) is one step lighter than the #263238
    // brand tile, so the product mark keeps its rounded-square shape; the dark
    // palette keeps the same relationship.
    out property <color> toolbar-bg: dark ? #1e262e : #37474f;
    out property <color> titlebar-bg: dark ? #1e262e : #37474f;
    out property <color> window-border: dark ? #0d1114 : #455a64;
    out property <color> toolbar-hover: dark ? rgba(255, 255, 255, 0.06)
                                            : rgba(255, 255, 255, 0.08);
    out property <color> toolbar-pressed: dark ? rgba(255, 255, 255, 0.10)
                                              : rgba(255, 255, 255, 0.14);
    out property <color> toolbar-divider: dark ? #111820 : #2b3a41;
    out property <color> toolbar-icon: dark ? #b0bec5 : #cfd8dc;
    out property <color> toolbar-icon-disabled: dark ? #52606b : #607d8b;
    out property <color> toolbar-label: dark ? #e2e8f0 : #eceff1;
    // Status chip inside the toolbar.
    out property <color> toolbar-chip-bg: rgba(255, 255, 255, 0.05);

    // Window caption buttons: the close button keeps the Windows red.
    out property <color> window-close-hover: #e81123;
    out property <color> window-close-pressed: #b91c1c;

    // Product mark (see ui/icons/app-icon.svg): #263238 tile, #fafafa glyph,
    // and the same top-light sheen as the exported icon (white 12 % at the top
    // edge fading out by 42 %, black 2 % at 72 % and 10 % at the bottom edge).
    // The sheen is a separate brush so `BrandMark` can overlay it on the tile
    // without duplicating the gradient in every use site.
    out property <color> brand-bg: #263238;
    out property <color> brand-glyph: #fafafa;
    out property <brush> brand-sheen: @linear-gradient(180deg,
        rgba(255, 255, 255, 0.12) 0%,
        rgba(255, 255, 255, 0) 42%,
        rgba(0, 0, 0, 0.02) 72%,
        rgba(0, 0, 0, 0.10) 100%);

    // --- Text -------------------------------------------------------------
    out property <color> text-strong: dark ? #f1f5f9 : #0f172a;
    out property <color> text: dark ? #cbd5e1 : #334155;
    out property <color> text-muted: dark ? #94a3b8 : #64748b;
    out property <color> text-faint: dark ? #6b7c8f : #94a3b8;
    out property <color> on-accent: #ffffff;

    // --- Semantic accents -------------------------------------------------
    out property <color> accent: dark ? #3b82f6 : #2563eb;
    out property <color> accent-strong: dark ? #60a5fa : #1d4ed8;
    out property <color> primary-hover: dark ? #2563eb : #3b82f6;
    out property <color> success: dark ? #22c55e : #16a34a;
    out property <color> warning: dark ? #f59e0b : #d97706;
    out property <color> danger: dark ? #ef4444 : #dc2626;

    // Tinted backgrounds for level chips, selected rows and messages. Each has
    // a matching foreground so the contrast works in both schemes.
    out property <color> info-soft: dark ? #1e3a5f : #eff6ff;
    out property <color> info-text: dark ? #93c5fd : #1d4ed8;
    out property <color> success-soft: dark ? #14351f : #dcfce7;
    out property <color> success-text: dark ? #86efac : #15803d;
    out property <color> warn-soft: dark ? #3a2c12 : #fffbeb;
    out property <color> warn-text: dark ? #fcd34d : #b45309;
    out property <color> danger-soft: dark ? #3a1c1e : #fef2f2;
    out property <color> danger-border: dark ? #5c2a2d : #fecaca;
    out property <color> danger-text: dark ? #fca5a5 : #b91c1c;

    // --- Controls ---------------------------------------------------------
    out property <color> track: dark ? #333c46 : #e2e8f0;
    out property <color> row-hover: dark ? #232b34 : #f8fafc;
    out property <color> row-alt: dark ? #1f262e : #fbfdff;
    out property <color> hover-bg: dark ? #262f39 : #f1f5f9;
    out property <color> pressed-bg: dark ? #2f3945 : #e2e8f0;
    out property <color> disabled-bg: dark ? #242c35 : #f1f5f9;
    out property <color> field-disabled-bg: dark ? #20272f : #f8fafc;
    out property <color> selection-bg: dark ? #1e3a5f : #bfdbfe;
    out property <color> selection-fg: dark ? #e2e8f0 : #0f172a;
    // Modal backdrop (settings/about). Written with `rgba()` on purpose: an
    // eight-digit hex literal in Slint is `#rrggbbaa`, so an intended
    // "alpha + black" value like `#99000000` reads as red 0x99 with alpha 0.
    // The previous light value `#66111827` therefore painted a faint maroon
    // wash instead of dimming; keep the parsed channels at pure black.
    out property <color> scrim: dark ? rgba(0, 0, 0, 0.60) : rgba(0, 0, 0, 0.40);

    // --- Service status (drawn on the dark header in both modes) ----------
    out property <color> status-idle: #94a3b8;
    out property <color> status-running: #22c55e;
    out property <color> status-busy: #f59e0b;
    out property <color> status-error: #ef4444;
    out property <color> status-running-text: #4ade80;
    out property <color> status-busy-text: #fbbf24;
    out property <color> status-error-text: #f87171;
}
