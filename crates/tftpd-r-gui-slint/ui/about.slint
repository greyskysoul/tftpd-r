// Modal "About" dialog.
import { Icons, MaterialIcon } from "icons.slint";
import { Theme } from "theme.slint";
import { IconButton, SmallButton, BrandMark } from "widgets.slint";

export component AboutDialog inherits Rectangle {
    in property <string> app-version: "0.0.0";
    // Name of the language the panel started in (see `i18n::Language`).
    in property <string> language: "";

    callback close-requested();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => { root.close-requested(); }
    }

    card := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 560px;
        height: 440px;

        background: Theme.panel-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.panel-border-strong;

        // Keep clicks inside the card from reaching the scrim below it.
        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 7px;
                Text {
                    text: @tr("About");
                    color: Theme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton {
                    icon-data: Icons.close;
                    button-size: 28px;
                    icon-size: 17px;
                    clicked => { root.close-requested(); }
                }
            }

            Rectangle { height: 1px; background: Theme.panel-border; }

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 14px;
                BrandMark { mark-size: 54px; }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "TftpdR";
                        color: Theme.text-strong;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: @tr("Version {}", root.app-version);
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                    Text {
                        text: @tr("Language: {}", root.language);
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }
            }

            Text {
                text: @tr("The R in TftpdR stands for Rust. This is a read-only TFTP server; the daemon and the desktop panel share one protocol core and one set of configuration rules.");
                color: Theme.text;
                font-size: 12px;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 7px;
                    MaterialIcon { path-data: Icons.check-circle; tint: Theme.success; icon-size: 14px; }
                    Text { text: @tr("RFC 1350 RRQ downloads, WRQ explicitly refused (read-only)"); color: Theme.text; font-size: 11px; }
                }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 7px;
                    MaterialIcon { path-data: Icons.check-circle; tint: Theme.success; icon-size: 14px; }
                    Text { text: @tr("blksize / timeout / tsize option negotiation and retransmission"); color: Theme.text; font-size: 11px; }
                }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 7px;
                    MaterialIcon { path-data: Icons.check-circle; tint: Theme.success; icon-size: 14px; }
                    Text { text: @tr("Component-wise path sandbox that rejects traversal, symlinks and device names"); color: Theme.text; font-size: 11px; }
                }
            }

            Rectangle { height: 1px; background: Theme.panel-border; }

            VerticalLayout {
                spacing: 3px;
                Text {
                    text: @tr("Icons: Google Material Design Icons (Apache License 2.0)");
                    color: Theme.text-muted;
                    font-size: 10px;
                }
                Text {
                    text: @tr("License: MIT OR Apache-2.0 · uploads are not implemented, the server is read-only");
                    color: Theme.text-muted;
                    font-size: 10px;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            HorizontalLayout {
                cross-axis-alignment: center;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SmallButton {
                    label: @tr("Close");
                    primary: true;
                    button-width: 72px;
                    clicked => { root.close-requested(); }
                }
            }
        }
    }
}
