// Modal settings dialog. Values are validated by the Rust side with the same
// `ServerConfig::validate` rules as the daemon; a successful save closes the
// dialog, an invalid value keeps it open and shows the error inline.
//
// The bind address is a multi-select list: the compact field opens an in-dialog
// picker (a drop-down style panel anchored under the field) that always offers
// "全部网络 (0.0.0.0)" and "本地回环 (127.0.0.1)" plus the addresses discovered
// on this machine. "全部网络" is exclusive and cannot be unchecked; the Rust
// side applies the toggle rules (see `toggle_address_choice` in src/main.rs).
import { ScrollView } from "std-widgets.slint";
import { Icons, MaterialIcon } from "icons.slint";
import { AddressOption } from "models.slint";
import { Theme } from "theme.slint";
import {
    DisabledCheckRow,
    IconButton,
    SmallButton,
    TextField,
} from "widgets.slint";

export component SettingsDialog inherits Rectangle {
    in-out property <string> port: "69";
    in-out property <[AddressOption]> address-options: [];
    in-out property <string> bind-summary: "";
    in-out property <string> root-dir: "";
    in-out property <string> block-size: "512";
    in-out property <string> timeout-secs: "3";
    in-out property <string> max-sessions: "16";
    in property <string> error-text: "";
    in property <string> hint-text: "";
    in-out property <bool> picker-open: false;
    property <length> card-height: 492px
        + (root.error-text == "" ? 0px : 52px)
        + (root.hint-text == "" ? 0px : 26px);

    callback apply-requested();
    callback cancel-requested();
    callback address-toggled(string);
    callback browse-requested();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => { root.cancel-requested(); }
    }

    card := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 640px;
        // The validation error box only appears on failure; give it room
        // instead of letting the fixed-height card clip the footer.
        height: root.card-height;

        background: Theme.panel-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.panel-border-strong;

        // Consume clicks inside the card so only the surrounding scrim closes
        // the dialog. Without this, clicking the padding between fields would
        // fall through to the scrim.
        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 7px;
                MaterialIcon {
                    path-data: Icons.settings;
                    tint: Theme.accent;
                    icon-size: 19px;
                }
                Text {
                    text: "服务设置";
                    color: Theme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton {
                    icon-data: Icons.close;
                    button-size: 28px;
                    icon-size: 17px;
                    clicked => { root.cancel-requested(); }
                }
            }

            Text {
                text: "与守护进程使用同一套 TOML 校验规则。保存后，运行中且无传输时自动重启；否则请稍后手动重启。";
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: Theme.panel-border; }

            VerticalLayout {
                spacing: 9px;

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: "绑定地址"; width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: address-touch.has-hover ? Theme.accent : Theme.panel-border-strong;
                        background: Theme.panel-bg;
                        clip: true;

                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 9px;
                            padding-right: 7px;
                            spacing: 6px;
                            Text {
                                text: root.bind-summary;
                                color: Theme.text-strong;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            MaterialIcon {
                                path-data: Icons.keyboard-arrow-down;
                                tint: Theme.text-muted;
                                icon-size: 16px;
                            }
                        }

                        address-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.picker-open = true; }
                        }
                    }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: "端口"; width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.port; placeholder: "69"; width: 120px; }
                    Text {
                        text: "标准端口 69 需要管理员/root；无权限时请改用 6969 等非特权端口。";
                        color: Theme.text-faint;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: "根目录"; width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.root-dir; placeholder: "请选择根目录"; horizontal-stretch: 1; }
                    SmallButton {
                        label: "浏览…";
                        button-width: 70px;
                        clicked => { root.browse-requested(); }
                    }
                }

                if root.hint-text != "" : HorizontalLayout {
                    Rectangle { width: 130px; background: transparent; }
                    Text {
                        text: root.hint-text;
                        color: Theme.text-muted;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: "最大块大小"; width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.block-size; placeholder: "512"; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: "超时（秒）"; width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.timeout-secs; placeholder: "3"; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: "最大并发会话"; width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.max-sessions; placeholder: "16"; horizontal-stretch: 1; }
                }
            }

            DisabledCheckRow {
                label: "允许上传（WRQ）— 本版本尚未实现";
            }

            if root.error-text != "" : Rectangle {
                background: #fef2f2;
                border-radius: 6px;
                border-width: 1px;
                border-color: #fecaca;
                height: 34px;
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    MaterialIcon {
                        path-data: Icons.error;
                        tint: Theme.danger;
                        icon-size: 15px;
                    }
                    Text {
                        text: root.error-text;
                        color: #b91c1c;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Rectangle { height: 1px; background: Theme.panel-border; }

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 8px;
                Text {
                    text: "只读模式：上传已在协议层禁用。";
                    color: Theme.text-faint;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SmallButton {
                    label: "取消";
                    tint: Theme.text-muted;
                    button-width: 72px;
                    clicked => { root.cancel-requested(); }
                }
                SmallButton {
                    label: "保存设置";
                    icon-data: Icons.check;
                    primary: true;
                    button-width: 96px;
                    clicked => { root.apply-requested(); }
                }
            }
        }
    }

    // Multi-select bind address picker, rendered above the card (sibling of the
    // card so it is painted last). Clicking the scrim closes it; the rows stay
    // open while several addresses are toggled.
    if root.picker-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.picker-open = false;
                }
            }
        }

        picker := Rectangle {
            x: (root.width - 600px) / 2;
            y: Math.max(12px, (root.height - root.card-height) / 2 + 142px);
            width: 600px;
            height: Math.max(190px, Math.min(root.address-options.length * 34px + 112px, 340px));

            background: Theme.panel-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.panel-border-strong;
            clip: true;

            // Consume clicks on the panel background so it does not fall
            // through to the scrim.
            TouchArea {
                clicked => {}
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 7px;
                    MaterialIcon {
                        path-data: Icons.dns;
                        tint: Theme.accent;
                        icon-size: 17px;
                    }
                    Text {
                        text: "选择绑定地址";
                        color: Theme.text-strong;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    IconButton {
                        icon-data: Icons.close;
                        button-size: 24px;
                        icon-size: 15px;
                        clicked => { root.picker-open = false; }
                    }
                }

                Text {
                    text: "可多选。选中具体地址会自动取消「全部网络」；选中「全部网络」会清空其他地址。端口对所有地址生效。";
                    color: Theme.text-muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Theme.panel-border; }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 2px;
                        for option in root.address-options : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: option-touch.has-hover ? Theme.row-hover : transparent;

                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: option.selected ? Theme.accent : Theme.panel-border-strong;
                                    background: option.selected ? Theme.accent : Theme.panel-bg;
                                    if option.selected : MaterialIcon {
                                        path-data: Icons.check;
                                        tint: #ffffff;
                                        icon-size: 11px;
                                        x: 2.5px;
                                        y: 2.5px;
                                    }
                                }
                                Text {
                                    text: option.label;
                                    color: Theme.text;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            option-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.address-toggled(option.address); }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.panel-border; }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 8px;
                    Text {
                        text: "显示的是本机网卡地址，权限不足的端口会在启动时给出提示。";
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    SmallButton {
                        label: "完成";
                        primary: true;
                        button-width: 72px;
                        clicked => { root.picker-open = false; }
                    }
                }
            }
        }
    }
}
