// Modal settings dialog. Values are validated by the Rust side with the same
// `ServerConfig::validate` rules as the daemon; a successful save closes the
// dialog, an invalid value keeps it open and shows the error inline.
//
// The bind address is a multi-select list: the compact field opens an in-dialog
// picker (a drop-down style panel anchored under the field) that always offers
// "All networks (0.0.0.0)" and "Loopback (127.0.0.1)" plus the addresses
// discovered on this machine. "All networks" is exclusive and cannot be
// unchecked; the Rust side applies the toggle rules (see `toggle_address_choice`
// in src/main.rs).
//
// The appearance row is the only setting that applies immediately instead of on
// 保存设置: a theme is a display preference, not server configuration, so it is
// applied and persisted by its own callback.
import { ScrollView } from "std-widgets.slint";
import { Icons, MaterialIcon } from "icons.slint";
import { AddressOption } from "models.slint";
import { Theme } from "theme.slint";
import {
    DisabledCheckRow,
    IconButton,
    SmallButton,
    TextField,
} from "widgets.slint";

export component SettingsDialog inherits Rectangle {
    in-out property <string> port: "69";
    in-out property <[AddressOption]> address-options: [];
    in-out property <string> bind-summary: "";
    in-out property <string> root-dir: "";
    in-out property <string> block-size: "512";
    in-out property <string> timeout-secs: "3";
    in-out property <string> max-sessions: "16";
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme-mode: 0;
    in property <string> error-text: "";
    in property <string> hint-text: "";
    in-out property <bool> picker-open: false;
    property <length> card-height: 531px
        + (root.error-text == "" ? 0px : 52px)
        + (root.hint-text == "" ? 0px : 26px);

    callback apply-requested();
    callback cancel-requested();
    callback address-toggled(string);
    callback browse-requested();
    callback theme-changed(int);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => { root.cancel-requested(); }
    }

    card := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 640px;
        // The validation error box only appears on failure; give it room
        // instead of letting the fixed-height card clip the footer.
        height: root.card-height;

        background: Theme.panel-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.panel-border-strong;

        // Consume clicks inside the card so only the surrounding scrim closes
        // the dialog. Without this, clicking the padding between fields would
        // fall through to the scrim.
        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 7px;
                MaterialIcon {
                    path-data: Icons.settings;
                    tint: Theme.accent;
                    icon-size: 19px;
                }
                Text {
                    text: @tr("Service settings");
                    color: Theme.text-strong;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton {
                    icon-data: Icons.close;
                    button-size: 28px;
                    icon-size: 17px;
                    clicked => { root.cancel-requested(); }
                }
            }

            Text {
                text: @tr("Uses the same TOML validation rules as the daemon. Saving restarts a running server automatically when no transfer is active; otherwise restart it manually later.");
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: Theme.panel-border; }

            VerticalLayout {
                spacing: 9px;

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Bind addresses"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: address-touch.has-hover ? Theme.accent : Theme.panel-border-strong;
                        background: Theme.panel-bg;
                        clip: true;

                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 9px;
                            padding-right: 7px;
                            spacing: 6px;
                            Text {
                                text: root.bind-summary;
                                color: Theme.text-strong;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            MaterialIcon {
                                path-data: Icons.keyboard-arrow-down;
                                tint: Theme.text-muted;
                                icon-size: 16px;
                            }
                        }

                        address-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.picker-open = true; }
                        }
                    }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Port"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.port; placeholder: "69"; width: 120px; }
                    Text {
                        text: @tr("The standard port 69 needs administrator/root; without permission use an unprivileged port such as 6969.");
                        color: Theme.text-faint;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Root directory"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.root-dir; placeholder: @tr("Select a root directory"); horizontal-stretch: 1; }
                    SmallButton {
                        label: @tr("Browse…");
                        button-width: 76px;
                        clicked => { root.browse-requested(); }
                    }
                }

                if root.hint-text != "" : HorizontalLayout {
                    Rectangle { width: 130px; background: transparent; }
                    Text {
                        text: root.hint-text;
                        color: Theme.text-muted;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Max block size"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.block-size; placeholder: "512"; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Timeout (s)"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.timeout-secs; placeholder: "3"; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Max concurrent sessions"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    TextField { text <=> root.max-sessions; placeholder: "16"; horizontal-stretch: 1; }
                }

                // Appearance applies immediately; it is a local display
                // preference and never restarts the server.
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Appearance"); width: 120px; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 6px;
                        SmallButton {
                            label: @tr("Follow system");
                            primary: root.theme-mode == 0;
                            button-width: 104px;
                            clicked => { root.theme-changed(0); }
                        }
                        SmallButton {
                            label: @tr("Light");
                            primary: root.theme-mode == 1;
                            button-width: 72px;
                            clicked => { root.theme-changed(1); }
                        }
                        SmallButton {
                            label: @tr("Dark");
                            primary: root.theme-mode == 2;
                            button-width: 72px;
                            clicked => { root.theme-changed(2); }
                        }
                    }
                    Text {
                        text: @tr("Applies immediately and is remembered.");
                        color: Theme.text-faint;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            DisabledCheckRow {
                label: @tr("Allow uploads (WRQ) — not implemented in this release");
            }

            if root.error-text != "" : Rectangle {
                background: Theme.danger-soft;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.danger-border;
                height: 34px;
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    MaterialIcon {
                        path-data: Icons.error;
                        tint: Theme.danger;
                        icon-size: 15px;
                    }
                    Text {
                        text: root.error-text;
                        color: Theme.danger-text;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Rectangle { height: 1px; background: Theme.panel-border; }

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 8px;
                Text {
                    text: @tr("Read-only: uploads are disabled in the protocol layer.");
                    color: Theme.text-faint;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SmallButton {
                    label: @tr("Cancel");
                    tint: Theme.text-muted;
                    button-width: 80px;
                    clicked => { root.cancel-requested(); }
                }
                SmallButton {
                    label: @tr("Save settings");
                    icon-data: Icons.check;
                    primary: true;
                    button-width: 116px;
                    clicked => { root.apply-requested(); }
                }
            }
        }
    }

    // Multi-select bind address picker, rendered above the card (sibling of the
    // card so it is painted last). Clicking the scrim closes it; the rows stay
    // open while several addresses are toggled.
    if root.picker-open : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.picker-open = false;
                }
            }
        }

        picker := Rectangle {
            x: (root.width - 600px) / 2;
            y: Math.max(12px, (root.height - root.card-height) / 2 + 142px);
            width: 600px;
            height: Math.max(190px, Math.min(root.address-options.length * 34px + 112px, 340px));

            background: Theme.panel-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.panel-border-strong;
            clip: true;

            // Consume clicks on the panel background so it does not fall
            // through to the scrim.
            TouchArea {
                clicked => {}
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 7px;
                    MaterialIcon {
                        path-data: Icons.dns;
                        tint: Theme.accent;
                        icon-size: 17px;
                    }
                    Text {
                        text: @tr("Select bind addresses");
                        color: Theme.text-strong;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    IconButton {
                        icon-data: Icons.close;
                        button-size: 24px;
                        icon-size: 15px;
                        clicked => { root.picker-open = false; }
                    }
                }

                Text {
                    text: @tr("Multi-select. Choosing a specific address clears “All networks”; choosing “All networks” clears the other addresses. The port applies to every address.");
                    color: Theme.text-muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Theme.panel-border; }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 2px;
                        for option in root.address-options : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: option-touch.has-hover ? Theme.row-hover : transparent;

                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: option.selected ? Theme.accent : Theme.panel-border-strong;
                                    background: option.selected ? Theme.accent : Theme.panel-bg;
                                    if option.selected : MaterialIcon {
                                        path-data: Icons.check;
                                        tint: Theme.on-accent;
                                        icon-size: 11px;
                                        x: 2.5px;
                                        y: 2.5px;
                                    }
                                }
                                Text {
                                    text: option.label;
                                    color: Theme.text;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            option-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.address-toggled(option.address); }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.panel-border; }

                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 8px;
                    Text {
                        text: @tr("These are this machine's interface addresses. A port without permission is reported when the server starts.");
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    SmallButton {
                        label: @tr("Done");
                        primary: true;
                        button-width: 72px;
                        clicked => { root.picker-open = false; }
                    }
                }
            }
        }
    }
}
