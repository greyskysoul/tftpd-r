// Custom title bar for the frameless main window. The whole bar is a window
// drag area (WindowMoveArea) with the window buttons on top of it; the
// resize border is provided by the window's `resize-border-width` property.
import { Icons, MaterialIcon } from "icons.slint";
import { Theme } from "theme.slint";
import { BrandMark } from "widgets.slint";

// A Windows-style caption button: compact, square-ish and quiet until hovered.
component WindowControl inherits Rectangle {
    in property <string> icon-data;
    in property <bool> danger: false;
    callback clicked();

    width: 40px;
    height: 30px;
    border-radius: 4px;
    background: touchArea.pressed
        ? (root.danger ? Theme.window-close-pressed : Theme.toolbar-pressed)
        : touchArea.has-hover
            ? (root.danger ? Theme.window-close-hover : Theme.toolbar-hover)
            : transparent;

    MaterialIcon {
        path-data: root.icon-data;
        tint: root.danger && (touchArea.has-hover || touchArea.pressed)
            ? Theme.on-accent
            : Theme.toolbar-icon;
        icon-size: 14px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
    }

    touchArea := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TitleBar inherits Rectangle {
    in property <bool> maximized: false;
    // Product tagline next to the brand name; the window passes the translated
    // text so the literal lives in one place (and can be read back in tests).
    in property <string> tagline: "";

    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();

    height: 36px;
    background: Theme.titlebar-bg;

    // Drag area limited to the left of the window buttons: if it covered the
    // buttons as well, a press on maximize/close could also start a window
    // move (which restores a maximized window on Windows).
    WindowMoveArea {
        enabled: true;
        x: 0;
        y: 0;
        width: parent.width - 150px;
        height: parent.height;
    }

    // No hairline between the title bar and the toolbar: both use the same flat
    // header colour, and the two rows are meant to read as one header block.

    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;

        // The product icon (ui/icons/app-icon.svg) at badge size: #263238 tile,
        // #fafafa glyph, no gradient — the panel surfaces stay flat.
        BrandMark { mark-size: 22px; }
        Text {
            text: "TftpdR";
            color: Theme.toolbar-label;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle {
            width: 1px;
            height: 14px;
            background: Theme.toolbar-divider;
        }
        Text {
            text: root.tagline;
            color: Theme.text-faint;
            font-size: 10px;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        WindowControl {
            icon-data: Icons.remove;
            clicked => { root.minimize-requested(); }
        }
        WindowControl {
            icon-data: root.maximized ? Icons.filter-none : Icons.crop-square;
            clicked => { root.maximize-requested(); }
        }
        WindowControl {
            icon-data: Icons.close;
            danger: true;
            clicked => { root.close-requested(); }
        }
    }
}
