// Activity log panel (upper pane of the main area). Newest entries are shown
// first so the newest event is visible without programmatic scrolling.
import { ScrollView } from "std-widgets.slint";
import { Icons, MaterialIcon } from "icons.slint";
import { LogRow } from "models.slint";
import { Theme } from "theme.slint";
import { Panel, SmallButton } from "widgets.slint";

export component LogsPanel inherits Panel {
    in property <[LogRow]> rows;
    callback clear-requested();

    min-height: 150px;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 8px;

        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: 7px;
            MaterialIcon {
                path-data: Icons.description;
                tint: Theme.accent;
                icon-size: 17px;
            }
            Text {
                text: "运行日志";
                color: Theme.text-strong;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: "最新在上";
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            SmallButton {
                label: "清空";
                icon-data: Icons.delete-sweep;
                tint: Theme.text-muted;
                button-width: 72px;
                clicked => { root.clear-requested(); }
            }
        }

        Rectangle { height: 1px; background: Theme.panel-border; }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 1px;
                if root.rows.length == 0 : Rectangle {
                    height: 120px;
                    VerticalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 6px;
                        MaterialIcon {
                            path-data: Icons.description;
                            tint: Theme.panel-border-strong;
                            icon-size: 30px;
                        }
                        Text {
                            text: "尚无日志。启动服务后，连接与传输事件会显示在这里。";
                            color: Theme.text-faint;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }
                for row in root.rows : Rectangle {
                    height: 26px;
                    clip: true;
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 4px;
                            spacing: 9px;
                            Text {
                                text: row.time;
                                color: Theme.text-faint;
                                font-size: 11px;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 48px;
                                height: 17px;
                                border-radius: 4px;
                                background: row.level == "ERROR" ? #fef2f2
                                    : row.level == "WARN" ? #fffbeb
                                    : #eff6ff;
                                Text {
                                    text: row.level;
                                    color: row.level == "ERROR" ? #b91c1c
                                        : row.level == "WARN" ? #b45309
                                        : #1d4ed8;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                            Text {
                                text: row.message;
                                color: Theme.text;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
