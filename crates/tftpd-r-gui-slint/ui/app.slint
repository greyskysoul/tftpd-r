// TftpdR panel layout:
//   toolbar  (start/restart, stop, settings, about)
//   main     (activity log on top, transfer table below)
//   status   (service state left; bind address + current root right)
// Settings, About and the recent-root drop-down are in-window overlays.
import { Palette } from "std-widgets.slint";
import { AddressOption, LogRow, RecentDir, TransferRow } from "models.slint";
import { Theme } from "theme.slint";
import { TitleBar } from "titlebar.slint";
import { TopToolbar } from "toolbar.slint";
import { StatusBar } from "statusbar.slint";
import { LogsPanel } from "logs.slint";
import { TransfersPanel } from "transfers.slint";
import { RootMenu } from "root-menu.slint";
import { SettingsDialog } from "settings.slint";
import { AboutDialog } from "about.slint";
import { ClosePromptDialog } from "close-prompt.slint";
// Top-level companions of the panel. They are compiled from this root so
// `slint::include_modules!()` generates their Rust types; neither is placed
// inside `AppWindow` (the prompt is its own window, the tray has no window).
import { InstancePromptWindow } from "single-instance.slint";
import { TrayIcon } from "tray.slint";
// Re-export the two top-level companions so the generated Rust module contains
// their public types even though they are not children of `AppWindow`.
export { InstancePromptWindow, TrayIcon }

export component AppWindow inherits Window {
    title: @tr("TftpdR · TFTP server");
    // Product icon (ui/icons/app-icon.svg) for the window and task-bar icon.
    // The panel build has no runtime image decoder, so the decoded pixels are
    // passed in from Rust (see `app_icon()` in src/main.rs) instead of using
    // `@image-url`.
    in property <image> app-icon;
    icon: root.app-icon;
    preferred-width: 1120px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.app-bg;

    // The panel draws its own header and window buttons, but the standard
    // widgets it embeds (the ScrollView scrollbars) take their colours from the
    // style's Palette. Mirror the resolved scheme into that palette: the
    // initial `init` covers startup and the `changed` handler covers a runtime
    // switch, including a change of the system theme.
    //
    // `dark-mode` is set from Rust (`apply_theme` in src/main.rs); the palette
    // global cannot be assigned from a component scope, so both the `Theme`
    // global and the style palette are driven from these handlers.
    in-out property <bool> dark-mode: false;
    property <ColorScheme> resolved-scheme: Theme.dark ? ColorScheme.dark : ColorScheme.light;
    init => {
        Theme.dark = self.dark-mode;
        Palette.color-scheme = self.resolved-scheme;
    }
    changed dark-mode => {
        Theme.dark = self.dark-mode;
        Palette.color-scheme = self.resolved-scheme;
    }

    // Frameless window: the title bar and window buttons are drawn by
    // `titlebar.slint`, while winit still provides edge/corner resizing for
    // this many pixels around the client area.
    no-frame: true;
    resize-border-width: 6px;

    in-out property <int> status-kind: 0;
    in-out property <string> status-text: "Stopped";
    in-out property <string> status-detail: "";
    in-out property <bool> primary-enabled: true;
    in-out property <bool> primary-is-restart: false;
    in-out property <bool> stop-enabled: false;
    in-out property <string> bind-text: "127.0.0.1:6969";
    in-out property <string> root-text: "No root directory";
    in-out property <string> throughput-text: "—";
    in-out property <string> active-text: "0 active";

    in-out property <bool> window-maximized: false;
    in-out property <bool> settings-open: false;
    // Also settable from Rust for the `TFTPD_R_GUI_PREVIEW=picker` development
    // screenshot mode; the settings dialog resets it when it closes.
    in-out property <bool> settings-picker-open: false;
    in-out property <bool> about-open: false;
    in-out property <bool> recent-menu-open: false;
    // "Close TftpdR?" prompt shown when the window is closed while the server
    // is still running. It is an in-window overlay so the operator keeps the
    // server status in view and Cancel leaves everything untouched.
    in-out property <bool> close-prompt-open: false;
    // Localised status detail of the running server, shown in that prompt.
    in-out property <string> close-prompt-detail: "";
    // False when this build/platform has no native tray backend; the close
    // prompt then offers only "Close and exit" and "Cancel".
    in-out property <bool> background-available: true;
    in-out property <string> app-version: "0.0.0";
    // Public repository address shown on the About page; set from Rust with the
    // Cargo package metadata so the URL is defined once.
    in-out property <string> repository-url: "";
    // Name of the language the panel started in (see `i18n::Language`).
    in-out property <string> language: "English";
    // Translated product tagline shown in the title bar. It is a property rather
    // than a literal so the development smoke test can read it back and show
    // which catalogue was applied.
    out property <string> tagline: @tr("Rust TFTP server");

    in-out property <[RecentDir]> recent-dirs: [];
    in-out property <[TransferRow]> transfers: [];
    in-out property <[LogRow]> logs: [];
    // Activity-log display filter ("ALL"/"INFO"/"WARN"/"ERROR") and the number
    // of retained entries before filtering (used for the export button state).
    in-out property <string> log-filter: "ALL";
    // Expanded state of the log-level drop-down; also settable from Rust for
    // the `TFTPD_R_GUI_PREVIEW=log-filter` development screenshot mode.
    in-out property <bool> log-filter-open: false;
    in-out property <int> log-total-count: 0;

    in-out property <string> settings-port: "69";
    in-out property <[AddressOption]> settings-address-options: [];
    in-out property <string> settings-bind-summary: "";
    in-out property <string> settings-root: "";
    in-out property <string> settings-block-size: "512";
    in-out property <string> settings-timeout: "3";
    in-out property <string> settings-max-sessions: "16";
    in-out property <string> settings-error: "";
    in-out property <string> settings-hint: "";
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme-mode: 0;
    // 0 = follow the system, 1 = English, 2 = Simplified Chinese. The chosen
    // language is stored for the next start; the running panel keeps its
    // language so its log and native dialog titles stay consistent.
    in-out property <int> language-mode: 0;

    callback primary-requested();
    callback stop-requested();
    callback apply-settings();
    callback cancel-settings();
    callback address-toggled(string);
    callback browse-root();
    callback browse-root-menu();
    callback theme-mode-changed(int);
    callback language-mode-changed(int);
    callback settings-recent-selected(string);
    callback clear-logs();
    callback export-logs();
    callback log-filter-changed(string);
    callback recent-selected(string);
    callback clear-recent();
    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();
    callback close-and-exit-requested();
    callback background-requested();
    callback close-prompt-cancel-requested();
    callback open-repository-requested();

    VerticalLayout {
        TitleBar {
            maximized: root.window-maximized;
            tagline: root.tagline;
            minimize-requested => { root.minimize-requested(); }
            maximize-requested => { root.maximize-requested(); }
            close-requested => { root.close-requested(); }
        }

        TopToolbar {
            status-text: root.status-text;
            status-kind: root.status-kind;
            primary-enabled: root.primary-enabled;
            primary-is-restart: root.primary-is-restart;
            stop-enabled: root.stop-enabled;
            settings-active: root.settings-open;
            about-active: root.about-open;
            primary-requested => { root.primary-requested(); }
            stop-requested => { root.stop-requested(); }
            settings-requested => {
                root.about-open = false;
                root.settings-open = !root.settings-open;
                root.settings-picker-open = false;
                root.log-filter-open = false;
            }
            about-requested => {
                root.settings-open = false;
                root.about-open = !root.about-open;
                root.log-filter-open = false;
            }
        }

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            LogsPanel {
                vertical-stretch: 4;
                rows: root.logs;
                total-count: root.log-total-count;
                filter: root.log-filter;
                filter-open <=> root.log-filter-open;
                clear-requested => { root.clear-logs(); }
                export-requested => { root.export-logs(); }
                filter-changed(level) => {
                    root.log-filter = level;
                    root.log-filter-changed(level);
                }
            }

            TransfersPanel {
                vertical-stretch: 5;
                rows: root.transfers;
                active-text: root.active-text;
                throughput-text: root.throughput-text;
            }
        }

        StatusBar {
            bind-text: root.bind-text;
            root-text: root.root-text;
            detail-text: root.status-detail;
            root-clicked => {
                root.recent-menu-open = !root.recent-menu-open;
                root.log-filter-open = false;
            }
        }
    }

    if root.recent-menu-open : RootMenu {
        items: root.recent-dirs;
        dismissed => { root.recent-menu-open = false; }
        selected(path) => {
            root.recent-menu-open = false;
            root.recent-selected(path);
        }
        browse-requested => {
            root.recent-menu-open = false;
            root.browse-root-menu();
        }
        clear-requested => { root.clear-recent(); }
    }

    if root.settings-open : SettingsDialog {
        port <=> root.settings-port;
        address-options <=> root.settings-address-options;
        bind-summary <=> root.settings-bind-summary;
        root-dir <=> root.settings-root;
        block-size <=> root.settings-block-size;
        timeout-secs <=> root.settings-timeout;
        max-sessions <=> root.settings-max-sessions;
        theme-mode <=> root.theme-mode;
        language-mode <=> root.language-mode;
        recent-dirs: root.recent-dirs;
        picker-open <=> root.settings-picker-open;
        error-text: root.settings-error;
        hint-text: root.settings-hint;
        apply-requested => { root.apply-settings(); }
        cancel-requested => { root.cancel-settings(); }
        address-toggled(address) => { root.address-toggled(address); }
        browse-requested => { root.browse-root(); }
        recent-dir-selected(path) => { root.settings-recent-selected(path); }
        theme-changed(mode) => {
            root.theme-mode = mode;
            root.theme-mode-changed(mode);
        }
        language-changed(mode) => {
            root.language-mode = mode;
            root.language-mode-changed(mode);
        }
    }

    if root.about-open : AboutDialog {
        app-version: root.app-version;
        language: root.language;
        repository-url: root.repository-url;
        close-requested => { root.about-open = false; }
        open-repository => { root.open-repository-requested(); }
    }

    // Drawn last so it covers the title bar, toolbar and every other dialog:
    // while it is open the window must not be closed or hidden by accident.
    if root.close-prompt-open : ClosePromptDialog {
        detail-text: root.close-prompt-detail;
        background-available: root.background-available;
        close-and-exit-requested => { root.close-and-exit-requested(); }
        background-requested => { root.background-requested(); }
        cancel-requested => { root.close-prompt-cancel-requested(); }
    }

    // A one-pixel dark frame keeps the frameless window visually contained
    // against light desktops and matches the dark header.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        border-width: 1px;
        border-color: Theme.window-border;
    }
}
