import { Button, ScrollView } from "std-widgets.slint";
import { TransferRow } from "models.slint";

export component Dashboard inherits Rectangle {
    in property <string> status-text: "Stopped";
    in property <int> status-kind: 0;
    in property <bool> can-start: true;
    in property <bool> can-stop: false;
    in property <string> bind-text: "—";
    in property <string> root-text: "—";
    in property <string> session-count: "0";
    in property <string> throughput-text: "—";
    in property <string> error-text: "";
    in property <[TransferRow]> transfers;
    callback start-requested();
    callback stop-requested();

    background: transparent;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Rectangle {
            background: white;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e2e8f0;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Server status";
                        font-size: 16px;
                        font-weight: 600;
                        color: #0f172a;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 26px;
                        min-width: 92px;
                        border-radius: 13px;
                        background: root.status-kind == 1 ? #dcfce7 : root.status-kind == 4 ? #fee2e2 : root.status-kind == 2 ? #e0f2fe : #e2e8f0;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.status-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: 600;
                            color: root.status-kind == 1 ? #166534 : root.status-kind == 4 ? #991b1b : root.status-kind == 2 ? #075985 : #475569;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: "Start server";
                        enabled: root.can-start;
                        clicked => { root.start-requested(); }
                    }
                    Button {
                        text: "Stop server";
                        enabled: root.can-stop;
                        clicked => { root.stop-requested(); }
                    }
                }
                if root.error-text != "" : Text {
                    text: root.error-text;
                    color: #b91c1c;
                    wrap: word-wrap;
                    font-size: 13px;
                }
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Bind address"; width: 140px; color: #64748b; font-size: 13px; }
                        Text { text: root.bind-text; color: #0f172a; font-size: 13px; font-weight: 500; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Root directory"; width: 140px; color: #64748b; font-size: 13px; }
                        Text { text: root.root-text; color: #0f172a; font-size: 13px; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Mode"; width: 140px; color: #64748b; font-size: 13px; }
                        Text { text: "Read-only (RRQ) · uploads disabled"; color: #0f172a; font-size: 13px; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Active transfers"; width: 140px; color: #64748b; font-size: 13px; }
                        Text { text: root.session-count; color: #0f172a; font-size: 13px; }
                    }
                }
            }
        }

        Rectangle {
            background: white;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e2e8f0;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: "Active transfers";
                        font-size: 16px;
                        font-weight: 600;
                        color: #0f172a;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.throughput-text;
                        color: #64748b;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                if root.transfers.length == 0 : Text {
                    text: "No active transfers. Start the server and connect a TFTP client.";
                    color: #94a3b8;
                    font-size: 13px;
                }
                ScrollView {
                    height: 300px;
                    VerticalLayout {
                        spacing: 8px;
                        for row in root.transfers: Rectangle {
                            height: 62px;
                            border-radius: 8px;
                            background: #f8fafc;
                            border-width: 1px;
                            border-color: #eef2f7;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: row.file;
                                        color: #0f172a;
                                        font-size: 13px;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: row.bytes;
                                        color: #475569;
                                        font-size: 12px;
                                    }
                                }
                                Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #e2e8f0;
                                    Rectangle {
                                        width: parent.width * row.progress;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: row.progress >= 1 ? #16a34a : #2563eb;
                                    }
                                }
                                HorizontalLayout {
                                    Text { text: row.peer; color: #94a3b8; font-size: 11px; horizontal-stretch: 1; }
                                    Text { text: row.status; color: #64748b; font-size: 11px; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
