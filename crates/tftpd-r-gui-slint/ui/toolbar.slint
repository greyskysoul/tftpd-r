// Toolbar with the primary server actions. The brand and window controls live
// in the custom title bar above it, so both rows form one dark header block.
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";
import { ToolButton } from "widgets.slint";

export component TopToolbar inherits Rectangle {
    in property <bool> primary-enabled: true;
    in property <bool> primary-is-restart: false;
    in property <bool> stop-enabled: false;
    in property <bool> settings-active: false;
    in property <bool> about-active: false;
    in property <string> status-text: "Stopped";
    in property <int> status-kind: 0;

    callback primary-requested();
    callback stop-requested();
    callback settings-requested();
    callback about-requested();

    height: 72px;
    background: Theme.toolbar-bg;

    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;

        // Service status is the first thing in the toolbar so the running /
        // stopped state is visible at a glance.
        Rectangle {
            width: 132px;
            height: 44px;
            border-radius: 8px;
            background: Theme.toolbar-chip-bg;

            HorizontalLayout {
                cross-axis-alignment: center;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 5px;
                    background: root.status-kind == 1 ? Theme.status-running
                        : root.status-kind == 4 ? Theme.status-error
                        : root.status-kind == 2 || root.status-kind == 3 ? Theme.status-busy
                        : Theme.status-idle;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0;
                    Text {
                        text: @tr("Service status");
                        color: Theme.text-faint;
                        font-size: 9px;
                    }
                    Text {
                        text: root.status-text;
                        color: root.status-kind == 1 ? Theme.status-running-text
                            : root.status-kind == 4 ? Theme.status-error-text
                            : root.status-kind == 2 || root.status-kind == 3 ? Theme.status-busy-text
                            : Theme.toolbar-icon;
                        font-size: 13px;
                        font-weight: 700;
                    }
                }
            }
        }

        Rectangle { width: 1px; height: 30px; background: Theme.toolbar-divider; }
        Rectangle { width: 4px; background: transparent; }

        ToolButton {
            label: root.primary-is-restart ? @tr("Restart") : @tr("Start");
            icon-data: root.primary-is-restart ? Icons.restart-alt : Icons.play-arrow;
            icon-tint: root.primary-is-restart ? Theme.status-busy-text : Theme.status-running-text;
            label-tint: Theme.toolbar-label;
            available: root.primary-enabled;
            clicked => { root.primary-requested(); }
        }

        ToolButton {
            label: @tr("Stop");
            icon-data: Icons.stop;
            icon-tint: Theme.status-error-text;
            available: root.stop-enabled;
            clicked => { root.stop-requested(); }
        }

        Rectangle { width: 6px; background: transparent; }

        ToolButton {
            label: @tr("Settings");
            icon-data: Icons.settings;
            active: root.settings-active;
            clicked => { root.settings-requested(); }
        }

        ToolButton {
            label: @tr("About");
            icon-data: Icons.info;
            active: root.about-active;
            clicked => { root.about-requested(); }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}
