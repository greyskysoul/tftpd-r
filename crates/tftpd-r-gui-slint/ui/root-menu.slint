// Recent root directories drop-down. Rendered as an in-window overlay anchored
// above the status bar: clicking outside dismisses it, clicking an entry applies
// that directory as the new root.
import { ScrollView } from "std-widgets.slint";
import { Icons, MaterialIcon } from "icons.slint";
import { RecentDir } from "models.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";

export component RootMenu inherits Rectangle {
    in property <[RecentDir]> items;

    callback dismissed();
    callback selected(string);

    width: 100%;
    height: 100%;
    background: transparent;

    // Clicking anywhere outside the card dismisses the menu. Reacting to the
    // press (instead of the click) makes the dismissal deterministic and avoids
    // a released press from the status-bar button closing a freshly opened menu.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }

    card := Rectangle {
        x: root.width - self.width - 16px;
        y: root.height - self.height - 50px;
        width: 520px;
        height: min(112px + root.items.length * 44px, root.height - 150px);

        background: Theme.panel-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.panel-border-strong;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 7px;
                MaterialIcon {
                    path-data: Icons.history;
                    tint: Theme.accent;
                    icon-size: 17px;
                }
                Text {
                    text: "最近使用的根目录";
                    color: Theme.text-strong;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton {
                    icon-data: Icons.close;
                    button-size: 24px;
                    icon-size: 15px;
                    clicked => { root.dismissed(); }
                }
            }

            Rectangle { height: 1px; background: Theme.panel-border; }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 2px;
                    if root.items.length == 0 : Text {
                        text: "暂无最近使用的目录。在设置中填写根目录并启动一次服务后，它会出现在这里。";
                        color: Theme.text-faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    for dir in root.items : Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: itemTouch.has-hover ? Theme.row-hover
                            : dir.active ? #eff6ff
                            : transparent;

                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            MaterialIcon {
                                path-data: dir.active ? Icons.check-circle : Icons.folder-open;
                                tint: dir.active ? Theme.success : Theme.text-muted;
                                icon-size: 17px;
                            }
                            VerticalLayout {
                                spacing: 1px;
                                Text {
                                    text: dir.name;
                                    color: Theme.text-strong;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: dir.path;
                                    color: Theme.text-faint;
                                    font-size: 10px;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if dir.active : Text {
                                text: "当前";
                                color: Theme.success;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        itemTouch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected(dir.path); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.panel-border; }
            Text {
                text: "服务运行中切换目录后，重启服务即可生效。";
                color: Theme.text-faint;
                font-size: 10px;
            }
        }
    }
}
