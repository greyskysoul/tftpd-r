// Recent root directories drop-down. Rendered as an in-window overlay anchored
// above the status bar: clicking outside dismisses it, clicking an entry applies
// that directory as the new root.
import { ScrollView } from "std-widgets.slint";
import { Icons, MaterialIcon } from "icons.slint";
import { RecentDir } from "models.slint";
import { Theme } from "theme.slint";
import { IconButton, SmallButton } from "widgets.slint";

export component RootMenu inherits Rectangle {
    in property <[RecentDir]> items;

    callback dismissed();
    callback selected(string);
    callback browse-requested();
    callback clear-requested();

    width: 100%;
    height: 100%;
    background: transparent;

    // Clicking anywhere outside the card dismisses the menu. Reacting to the
    // press (instead of the click) makes the dismissal deterministic and avoids
    // a released press from the status-bar button closing a freshly opened menu.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }

    card := Rectangle {
        x: root.width - self.width - 16px;
        y: root.height - self.height - 50px;
        width: 520px;
        // The base height leaves room for the toolbar row, the clear button and
        // the empty-state hint; each entry adds a 40 px row plus spacing.
        height: min(150px + root.items.length * 44px, root.height - 150px);

        background: Theme.panel-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.panel-border-strong;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                cross-axis-alignment: center;
                spacing: 7px;
                MaterialIcon {
                    path-data: Icons.history;
                    tint: Theme.accent;
                    icon-size: 17px;
                }
                Text {
                    text: @tr("Recent root directories");
                    color: Theme.text-strong;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SmallButton {
                    label: @tr("Select…");
                    icon-data: Icons.folder-open;
                    button-width: 88px;
                    clicked => { root.browse-requested(); }
                }
                SmallButton {
                    label: @tr("Clear");
                    icon-data: Icons.delete-sweep;
                    tint: Theme.text-muted;
                    button-width: 72px;
                    available: root.items.length > 0;
                    clicked => { root.clear-requested(); }
                }
                IconButton {
                    icon-data: Icons.close;
                    button-size: 24px;
                    icon-size: 15px;
                    clicked => { root.dismissed(); }
                }
            }

            Rectangle { height: 1px; background: Theme.panel-border; }

            ScrollView {
                vertical-stretch: 1;
                // Long paths are elided below; a horizontal scrollbar would
                // shift the whole list while dragging and make the overlay look
                // like it jumps, so horizontal panning is disabled.
                horizontal-scrollbar-policy: always-off;
                mouse-drag-pan-enabled: false;
                VerticalLayout {
                    spacing: 2px;
                    if root.items.length == 0 : Text {
                        text: @tr("No recent directories.");
                        color: Theme.text-faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    for dir in root.items : Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: itemTouch.has-hover ? Theme.row-hover
                            : dir.active ? Theme.info-soft
                            : transparent;

                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            MaterialIcon {
                                path-data: dir.active ? Icons.check-circle : Icons.folder-open;
                                tint: dir.active ? Theme.success : Theme.text-muted;
                                icon-size: 17px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text {
                                    text: dir.name;
                                    color: Theme.text-strong;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 100%;
                                    overflow: elide;
                                }
                                Text {
                                    text: dir.path;
                                    color: Theme.text-faint;
                                    font-size: 10px;
                                    width: 100%;
                                    overflow: elide;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if dir.active : Text {
                                text: @tr("Current");
                                color: Theme.success;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        itemTouch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected(dir.path); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.panel-border; }
            Text {
                text: @tr("Switching the root restarts an idle server.");
                color: Theme.text-faint;
                font-size: 10px;
            }
        }
    }
}
