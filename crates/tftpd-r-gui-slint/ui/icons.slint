// A Material icon rendered as a vector path. `path-data` receives one of the
// `Icons.*` constants; `icon-size` is the rendered square size in px.
export component MaterialIcon inherits Path {
    in property <string> path-data;
    in property <color> tint: #334155;
    in property <length> icon-size: 20px;

    width: self.icon-size;
    height: self.icon-size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: self.path-data;
    fill: self.tint;
    fill-rule: nonzero;
}
